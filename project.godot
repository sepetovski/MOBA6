[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Props"
3d_physics/layer_3="Units"
3d_physics/layer_4="Projectiles"
3d_physics/layer_5="Triggers"
3d_physics/layer_6="Pick"
3d_physics/layer_7="NavBlock"
3d_physics/layer_8="Occluders"

[rendering]

lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1

[navigation]

3d/default_cell_size=0.2
3d/default_cell_height=0.1

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true
